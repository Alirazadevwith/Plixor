DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
SECRET_KEY=your-super-secret-key-min-32-chars-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ---- AI provider: fill EXACTLY ONE of the two keys below ----
# Both are optional. With neither set, the app still runs: login, sections,
# exam building, student exam-taking and PDF upload all work. Only AI question
# generation, AI rubric generation and subjective grading need a provider.
#
# If you fill both, Gemini wins (the stronger grader).
# Set AI_PROVIDER to force one explicitly (gemini | groq).

# https://aistudio.google.com/apikey  -> grading on gemini-2.5-pro
GEMINI_API_KEY=

# https://console.groq.com/keys  -> grading on llama-3.3-70b-versatile
GROQ_API_KEY=

AI_PROVIDER=

# ---- limits and rules (all optional; defaults shown) ----
# Change any of these from the platform dashboard without a code change.
MAX_UPLOAD_BYTES=10485760          # 10 MB on the wire
MAX_DOCX_XML_BYTES=8388608         # 8 MB of uncompressed word/document.xml
MAX_PDF_PAGES=50
MAX_EXTRACTED_CHARS=50000
EXTRACTION_TIMEOUT_SECONDS=20
CHEATING_WARNING_LIMIT=2           # violations before auto-submit
PASS_MARK_FRACTION=0.5             # counts as a pass in analytics

# Model ids are configuration: providers rename and retire models, so a 404
# model_not_found is fixed here rather than in code.
GEMINI_GRADING_MODEL=gemini-2.5-pro
GEMINI_GENERATION_MODEL=gemini-2.5-flash
GROQ_GRADING_MODEL=openai/gpt-oss-120b
GROQ_GENERATION_MODEL=openai/gpt-oss-20b

LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=plixor
LANGSMITH_TRACING=false
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
